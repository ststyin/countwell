{
  "name": "countwell",
  "description": "Count well. Live well.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/start.ts --dev",
    "build": "tsc -b && vite build",
    "preview": "tsx server/start.ts",
    "start": "tsx server/start.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cloud:build": "tsc -b && node scripts/build-cloud.mjs",
    "cloud:sync": "node --import tsx scripts/sync-cloud-ledger.ts",
    "cloud:auto:install": "node --import tsx scripts/install-auto-sync.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1"
  }
}
