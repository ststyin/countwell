{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "countwell-demo",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // PWA precaching needs direct responses for /index.html and /offline.html.
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
